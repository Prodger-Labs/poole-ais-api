# Copy to .env and fill in. .env is gitignored.

# Gravitee management API. Not the gateway, and not the console UI root.
GRAVITEE_MANAGEMENT_URL=https://gravitee.prodger.cc/management
GRAVITEE_ADMIN_USER=admin
GRAVITEE_ADMIN_PASSWORD=

# Where the deployed API will be callable from, used only to print the URLs
# at the end of a deploy.
GRAVITEE_GATEWAY_URL=https://gateway.prodger.cc

# The sharding tag this gateway serves. An API without a matching tag reads
# STARTED and PUBLISHED in the console and 404s at the gateway for ever.
GRAVITEE_GATEWAY_TAG=gamma

# The receiver's public hostname, and the shared secret it requires on every
# request. Must be byte-identical to AIS_LIVE_API_SECRET on the receiver, or
# every call comes back 403.
AIS_UPSTREAM_URL=https://ais-api.prodger.cc
AIS_UPSTREAM_SECRET=

# Requests per second per API key.
AIS_RATE_LIMIT=5
